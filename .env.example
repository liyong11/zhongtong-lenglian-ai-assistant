# 必填：对外域名，DNS A 记录必须指向本机公网 IP（Caddy 自动签 HTTPS）
DOMAIN=ai.example.com

# 选填：管理令牌。不启用钉钉登录时建议设置，生成：openssl rand -hex 24
ADMIN_TOKEN=

# 选填：限流与并发上限
CHAT_RATE_LIMIT=30
SSE_MAX_CONCURRENT=100

# 选填：构建镜像时的 npm 源
NPM_REGISTRY=https://registry.npmmirror.com

# 选填：基础镜像源（默认已用 DaoCloud 国内镜像；海外网络可改为 node:22-alpine / caddy:2-alpine）
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine
