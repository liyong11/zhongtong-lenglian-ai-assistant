# 对外端口与监听地址
APP_PORT=8787
# 有 HTTPS 反代时改 127.0.0.1；直接对外访问用 0.0.0.0
APP_BIND=127.0.0.1

# 钉钉回调使用的最终 HTTPS 地址，必须和开放平台登记的回调地址同域
PUBLIC_ORIGIN=https://ai.example.com

# 过渡用：还没配好钉钉时用令牌进后台；钉钉登录生效后可留空
ADMIN_TOKEN=

# 钉钉企业内部应用凭据（配好后后台强制钉钉登录）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=

# 选填：限流与并发上限
CHAT_RATE_LIMIT=30
SSE_MAX_CONCURRENT=100

# 选填：构建镜像时的 npm 源
NPM_REGISTRY=https://registry.npmmirror.com

# 选填：基础镜像源（默认已用 DaoCloud 国内镜像；海外网络可改为 node:22-alpine）
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
