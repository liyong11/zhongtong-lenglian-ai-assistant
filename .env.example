# 对外端口与监听地址
APP_PORT=8787
APP_BIND=0.0.0.0

# 管理端口：公共端口只留气泡/对话，后台只在管理端口响应
ADMIN_PORT=8788
# 管理端口的宿主绑定地址：127.0.0.1 仅本机；内网访问改成 0.0.0.0 或内网网卡 IP
ADMIN_HOST_BIND=127.0.0.1

# 管理令牌：分端口部署必填（未设置会拒绝启动）；单端口内网可留空
ADMIN_TOKEN=

# 选填：钉钉企业内部应用凭据。config.json 里留空时用这里的值
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=

# 选填：放到 HTTPS 反向代理后面时填最终地址，例如 https://ai.example.com
PUBLIC_ORIGIN=

# 选填：限流与并发上限
CHAT_RATE_LIMIT=30
SSE_MAX_CONCURRENT=100

# 选填：构建镜像时的 npm 源
NPM_REGISTRY=https://registry.npmmirror.com

# 选填：基础镜像源（默认已用 DaoCloud 国内镜像；海外网络可改为 node:22-alpine）
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
