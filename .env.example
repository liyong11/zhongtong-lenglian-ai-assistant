# 对外端口与监听地址
APP_PORT=8787
APP_BIND=0.0.0.0

# 选填：管理令牌。服务器对其他人可达时建议设置，生成：openssl rand -hex 24
ADMIN_TOKEN=

# 选填：放到 HTTPS 反向代理后面时填最终地址，例如 https://ai.example.com
PUBLIC_ORIGIN=

# 选填：限流与并发上限
CHAT_RATE_LIMIT=30
SSE_MAX_CONCURRENT=100

# 选填：构建镜像时的 npm 源
NPM_REGISTRY=https://registry.npmmirror.com

# 选填：基础镜像源（默认已用 DaoCloud 国内镜像；海外网络可改为 node:22-alpine）
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
